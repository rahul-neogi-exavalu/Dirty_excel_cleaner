# Template only -- never put real credentials here; this file is committed.
# Copy to backend/.env (or .env in the project root) and fill in. Both are git-ignored.
# Real environment variables override either file; backend/.env wins over the root .env.

# --- Bronze database (Postgres) ---------------------------------------------
# The Ingest step stays locked until host, database name and user are set.
AHI_DB_HOST=<your-postgres-host>
AHI_DB_PORT=5432
AHI_DB_NAME=<database-name>
AHI_DB_USER=<username>
AHI_DB_PASSWORD=<password>
# disable | allow | prefer | require | verify-ca | verify-full (use require for cloud)
AHI_DB_SSLMODE=require

# Schemas: raw ingested tables, and the registry / ingestion audit tables.
AHI_BRONZE_SCHEMA=bronze
AHI_CONTROL_SCHEMA=ingest

# Regex (one capture group) that finds the source system in a file name suffix,
# e.g. ARR_pc0515.xlsx -> pc0515. Leave unset for the default.
# AHI_SOURCE_SYSTEM_PATTERN=

# Set to false to hide the Ingest step entirely.
AHI_INGEST_ENABLED=true

# --- Silver layer --------------------------------------------------------------
AHI_SILVER_SCHEMA=silver
# The source-specific Silver Cleansed tables (one per bronze table, same name), loaded
# before Final Silver (silver_detail).
AHI_CLEANSED_SCHEMA=bronze_cleansed
# Hours an unapproved Silver review is kept (every edit renews it).
# AHI_SILVER_DRAFT_TTL_HOURS=72
# The business's reference workbooks (division mapping, LOTL, DRT column mapping), loaded
# into empty tables on first use. Unset: the project's assets/ folder.
# AHI_REFERENCE_DIR=assets
# The LOTL (profit_center_number, legacy_office_name, status). Unset: <control schema>.lotl,
# filled from assets/pc_name_pc_number_from_lotl.xlsx.
# AHI_LOTL_TABLE=reference.lotl
# silver_detail / silver_aggregate columns. Unset: backend/config/silver_columns.csv and
# backend/config/silver_aggregate_columns.csv
# AHI_SILVER_COLUMNS_FILE=
# AHI_SILVER_AGGREGATE_COLUMNS_FILE=

# Column mapping: saved, exact, fuzzy, word2vec and AI each vote on every column;
# the reviewer picks from the candidates.
AHI_MATCH_FUZZY_MIN=85
AHI_MATCH_SEMANTIC_MIN=0.72
# word2vec vectors file (word2vec text, binary or gzipped). Empty: no word2vec vote.
AHI_WORD2VEC_PATH=<path-to-word2vec-vectors.bin>

# AI vote. Provider: azure_openai | gemini. Unset: Azure OpenAI if configured, else Gemini.
# AHI_AI_PROVIDER=azure_openai
AHI_AI_ENABLED=true
# Sample values (3 per column) are sent to the AI only if set to true; names otherwise.
AHI_AI_SEND_SAMPLES=false

# Azure OpenAI (the default provider). The deployment needs structured outputs
# (e.g. gpt-4.1-mini, gpt-4o) and an API version of 2024-08-01-preview or later.
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>

# Gemini (optional alternative). Empty key: not used.
GEMINI_API_KEY=<your-gemini-api-key>
AHI_GEMINI_MODEL=gemini-2.5-flash

# --- App database: users (sign-in) and job history ---------------------------
# Its own database; it may be on the same server as the bronze one. Sign-in is
# unavailable until host, database name and user are set. Tables are created on first use;
# create the first admin with:  python backend/tools/create_user.py --name ... --email ... --admin
APP_DB_HOST=<your-postgres-host>
APP_DB_PORT=5432
APP_DB_NAME=<database-name>
APP_DB_USER=<username>
APP_DB_PASSWORD=<password>
# disable | allow | prefer | require | verify-ca | verify-full (use require for cloud)
APP_DB_SSLMODE=require
APP_DB_SCHEMA=public

# Signs the session cookie (HMAC-SHA256). Unset: a new one per restart, which signs
# everyone out. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=<long-random-string>
APP_SESSION_HOURS=12
# true when the app is served over HTTPS
APP_COOKIE_SECURE=false

# --- Cleaning service (optional) ---------------------------------------------
# AHI_WORK_DIR=backend/.workspace
# AHI_MAX_UPLOAD_MB=500
# AHI_MAX_BATCH_FILES=20
